---
import ThemeToggle from '@components/ThemeToggle.astro'
import { HEADLINE, NAME } from '@content/profile'

interface Props {
  /** Page name shown under the site name. Omit on Home, where the name itself is the heading. */
  title?: string
}

const { title } = Astro.props
---

<header class="flex items-start justify-between gap-4">
  {title === undefined ? (
    <div>
      <h1 class="font-medium text-text">{NAME}</h1>
      <p class="text-muted">{HEADLINE}</p>
    </div>
  ) : (
    <div>
      <p>
        <a href="/" class="font-medium text-text" data-astro-prefetch>
          {NAME}
        </a>
      </p>
      <h1 class="text-muted">{title}</h1>
    </div>
  )}
  <div class="-mr-3 -mt-2.5 flex">
    <button
      type="button"
      class="icon-button font-system-mono text-[13px]"
      aria-label="Open terminal mode"
      data-open-terminal
    >
      &gt;_
    </button>
    <ThemeToggle />
  </div>
</header>
