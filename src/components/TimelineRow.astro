---
interface Props {
  period: string
  /** Renders the row as an external link when set. */
  href?: string
}

const { period, href } = Astro.props
const ROW_CLASS = 'grid grid-cols-[88px_minmax(0,1fr)] gap-4 py-1.5'
---

{
  href === undefined ? (
    <div class={ROW_CLASS}>
      <span class="tabular-nums text-muted">{period}</span>
      <span>
        <slot />
      </span>
    </div>
  ) : (
    <a href={href} target="_blank" rel="noreferrer" class:list={['row-link', ROW_CLASS]}>
      <span class="tabular-nums text-muted">{period}</span>
      <span class="row-title">
        <slot />
      </span>
    </a>
  )
}
