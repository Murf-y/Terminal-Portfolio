# Netlify response headers. The site has no sessions or forms, so these close the remaining
# browser-level gaps: framing, MIME sniffing, referrer leakage, device APIs, base hijack.
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# Astro fingerprints everything under /_astro/, so a changed file always has a new URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
