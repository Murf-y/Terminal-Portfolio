---
import { CONTACT_LINKS } from '@content/profile'
---

<p class="flex flex-wrap gap-x-5 gap-y-1">
  {CONTACT_LINKS.map((link) => {
    // Email opens the mail client; every other link opens in a new tab.
    const opensElsewhere = link.id !== 'email'
    return (
      <a
        href={link.href}
        class="text-link"
        target={opensElsewhere ? '_blank' : undefined}
        rel={opensElsewhere ? 'noreferrer' : undefined}
      >
        {link.label}
      </a>
    )
  })}
  <slot />
</p>
