---
import { CONTACT_LINKS } from '@content/profile'
---

<p class="flex flex-wrap gap-x-5 gap-y-1">
  {
    CONTACT_LINKS.map((link) =>
      link.id === 'email' ? (
        <a href={link.href} class="text-link">
          {link.label}
        </a>
      ) : (
        <a href={link.href} class="text-link" target="_blank" rel="noreferrer">
          {link.label}
        </a>
      )
    )
  }
  <slot />
</p>
